# Defaults are safe: no live extraction, previews, or downloads.
PORT=3000
# Select exactly one provider. No automatic fallback from an API denial to public pages.
PINTEREST_PROVIDER=official
# Separate opt-in for permitted personal anonymous public-page reads. No API token needed.
# Public visibility alone is not permission for automated access; review Pinterest terms first.
PINTEREST_PUBLIC_PAGE_ENABLED=false
PINTEREST_PLATFORM_AUTHORIZED=false
PINTEREST_ACCESS_TOKEN=
# Exact directly connected reverse-proxy IPs only; blank ignores all proxy headers.
TRUST_PROXY_IPS=
